#!/usr/bin/env bash
#
# netdisk project controller (run from the project root):
#
#   ./setup        Interactive menu: 1 build / 2 clean / 3 back up (Enter = 1)
#   ./setup bd     Build current platform into ~/bn/netdisk
#   ./setup cl     Clean build output + caches (needs confirmation)
#   ./setup bk     Back up the project to ~/us/config/cd_netdisk.txz
#
#   1 Build   -> current platform only, straight into ~/bn/netdisk
#                (version stamped YY.MM.DD, CGO off, build beside target then
#                 rename so a running netdisk is not "text file busy")
#   2 Clean   -> ~/bn/netdisk, dist/ and in-tree build output; needs confirmation.
#                Keeps ~/.config/netdisk (config + log)
#   3 Back up -> ~/us/config/cd_netdisk.txz, skipping .git/dist/local binary
#
# Requirements: go, tar; notify-send optional
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$HOME/bn/netdisk"
ARCHIVE="$HOME/us/config/cd_netdisk.txz"

info() { printf '\033[1;34m==>\033[0m %s\n' "$1"; }
ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$1"; }
die()  { printf '\033[1;31m  ✗\033[0m %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- 1 build

build() {
  command -v go >/dev/null 2>&1 || die "go is not installed"
  local version
  version="$(date +%y.%m.%d)"
  info "Building netdisk $version -> $BIN ($(go env GOOS)/$(go env GOARCH))"
  mkdir -p "${BIN%/*}"
  # Build beside the target, then rename: go build -o onto a running binary
  # fails with "text file busy", and netdisk is often serving already
  ( cd "$ROOT" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.Version=$version" -o "$BIN.new" . )
  mv "$BIN.new" "$BIN"
  ok "Built $BIN ($(du -h "$BIN" | cut -f1))"
}

# ---------------------------------------------------------------- 2 clean

CLEAN_TARGETS=(
  "$BIN"
  "$ROOT/dist"
  "$ROOT/netdisk"
)

# Fixed targets + gitignored cross-compile leftovers (netdisk-linux_amd64, ...).
clean_paths() {
  local p extra
  for p in "${CLEAN_TARGETS[@]}"; do
    printf '%s\n' "$p"
  done
  for extra in "$ROOT"/netdisk-*; do
    [ -e "$extra" ] || continue
    printf '%s\n' "$extra"
  done
}

confirm_clean() {
  if [ "${ALLOW_CLEAN:-}" = "1" ]; then
    warn "ALLOW_CLEAN=1, skipping interactive confirmation"
    return 0
  fi
  [ -t 0 ] || die "Cleaning needs interactive confirmation; for non-interactive use ALLOW_CLEAN=1 ./setup"
  echo
  warn "Clean will remove these paths:"
  local p
  while IFS= read -r p; do
    if [ -e "$p" ]; then
      printf '    %s\n' "$p" >&2
    else
      printf '    %s  (not present)\n' "$p" >&2
    fi
  done < <(clean_paths)
  warn "Keeps: ~/.config/netdisk (config + log)"
  warn "Stop netdisk first if it is running"
  printf 'Confirm clean? [Y/n] ' >&2
  local answer
  read -r answer || answer=""
  case "$answer" in
    ""|y|Y) ;;
    *) die "Cancelled" ;;
  esac
}

clean() {
  confirm_clean
  info "Cleaning build output"

  local removed=0 path
  while IFS= read -r path; do
    [ -e "$path" ] || continue
    rm -rf "$path"
    ok "removed ${path#"$ROOT"/}"
    removed=$((removed + 1))
  done < <(clean_paths)

  if [ "$removed" -eq 0 ]; then
    ok "Nothing to clean"
  else
    ok "Clean complete; run ./setup and choose 1 to rebuild"
  fi
}

# ---------------------------------------------------------------- 3 backup

# Same shape as the old cmd_cd_netdisk_bk: skip .git and the in-tree binary,
# plus dist/ (build output) like the umission backup
backup() {
  mkdir -p "${ARCHIVE%/*}"
  info "Backing up $ROOT -> $ARCHIVE"
  tar -czf "$ARCHIVE" \
    --exclude='.git' \
    --exclude='dist' \
    --exclude='netdisk/netdisk' \
    -C "$(dirname "$ROOT")" "$(basename "$ROOT")"
  local size
  size="$(du -h "$ARCHIVE" | cut -f1)"
  ok "Backup written: $ARCHIVE ($size)"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "netdisk" "Backup finished: $ARCHIVE ($size)" || true
  fi
}

# ---------------------------------------------------------------- menu

case "${1:-}" in
  ""|menu) ;;
  -h|--help|help)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  bd) build;  exit 0 ;;
  cl) clean;  exit 0 ;;
  bk) backup; exit 0 ;;
  *) die "Unknown argument: $1 (bd=build, cl=clean, bk=backup, or no arg for menu)" ;;
esac

echo
printf 'What should netdisk setup do?\n'
printf '  \033[1m1\033[0m) [bd] Build current platform -> ~/bn/netdisk (version %s)\n' "$(date +%y.%m.%d)"
printf '  \033[1m2\033[0m) [cl] Clean build output (~/bn/netdisk, dist/, in-tree binaries)\n'
printf '  \033[1m3\033[0m) [bk] Back up the project to %s\n' "$ARCHIVE"
printf 'Select [1-3, default 1]: ' >&2
answer=""
read -r answer || answer=""
case "$answer" in
  ""|1) build ;;
  2)    clean ;;
  3)    backup ;;
  *)    die "Invalid input: $answer (use 1, 2 or 3)" ;;
esac
